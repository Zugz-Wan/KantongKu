// Prisma Schema untuk KantongKu

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // Password yang telah di-hash dengan bcrypt/argon2
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
